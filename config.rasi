configuration {
    show-icons:      true;
    drun-icon-theme: "Numix-Circle";
}

* {
    bg0:              #2E3440F2;
    bg1:              #3B4252;
    bg2:              #4C566A80;
    bg3:              #88C0D0F2;
    fg0:              #D8DEE9;
    fg1:              #ECEFF4;
    fg2:              #D8DEE9;
    fg3:              #4C566A;

    font:             "Roboto 12";
    background-color: transparent;
    text-color:       @fg0;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

window {
    location:         center;
    anchor:           center;
    width:            480;
    border-radius:    24px;
    background-color: @bg0;
}

mainbox {
    padding: 12px;
}

inputbar {
    border:           2px;
    border-radius:    16px;
    padding:          8px 16px;
    spacing:          8px;
    children:         [ prompt, entry ];
    background-color: @bg1;
    border-color:     @bg3;
}

prompt {
    text-color: @fg2;
}

entry {
    placeholder:        "Search";
    placeholder-color:  @fg3;
}

message {
    margin:           12px 0 0;
    border-radius:    16px;
    border-color:     @bg2;
    background-color: @bg2;
}

textbox {
    padding: 8px 24px;
}

listview {
    margin:           12px 0 0;
    columns:          1;
    lines:            8;
    fixed-height:     false;
    scrollbar:        false;
    background-color: transparent;
}

element {
    padding:        8px 16px;
    spacing:        8px;
    border-radius:  16px;
}

element normal active {
    text-color: @bg3;
}

element alternate active {
    text-color: @bg3;
}

element selected {
    text-color: @bg1;
}

element selected normal, element selected active {
    background-color: @bg3;
}

element-icon {
    size:           1em;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
}
